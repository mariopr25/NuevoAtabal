[moodle]
user = www-data
group = www-data
listen = /run/php/php{{ php_version }}-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = 75
pm.start_servers = 20
pm.min_spare_servers = 10
pm.max_spare_servers = 35
pm.max_requests = 500

env[PATH] = /usr/local/bin:/usr/bin:/bin
